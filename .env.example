# Copy this file to .env (same folder) and fill in your own values.
# Find both of these in your Supabase project: Settings -> API.
#
# The anon key is a PUBLIC key — it's meant to be shipped in frontend code.
# It is NOT the same as the "service_role" key, which is secret and must
# never be used here or committed anywhere. See SETUP.md for details.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
